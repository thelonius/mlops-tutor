# Скопируй в .env и подставь свой ключ
# Основной ключ — все текстовые модели идут через OpenRouter
# Получить: https://openrouter.ai/keys
# Без пополнения баланса free-модели ограничены 50 запросами/день,
# после депозита $10 — 1000/день.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Zhipu напрямую. glm-4.7-flash и glm-4.5-flash там бесплатны и идут мимо
# общего пула OpenRouter, который по free-моделям регулярно отдаёт 429.
# Получить: https://z.ai/manage-apikey/apikey-list
ZHIPU_API_KEY=

# Опционально — адрес приложения, уходит в заголовок HTTP-Referer OpenRouter
APP_URL=https://176-123-166-252.sslip.io/

# Опционально — только для распознавания речи (whisper-large-v3 в /api/transcribe).
# У OpenRouter нет audio/transcriptions, поэтому STT остался на Groq.
# https://console.groq.com/keys
GROQ_API_KEY=
